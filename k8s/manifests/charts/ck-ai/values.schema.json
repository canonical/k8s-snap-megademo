{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "type": "object",
  "properties": {
    "provider": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "required": ["model", "token"]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "required": ["repository", "tag"]
        },
        "port": {
          "type": "integer"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object",
          "properties": {
            "general_settings": {
              "type": "object"
            },
            "model_list": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "model_name": {
                    "type": "string"
                  },
                  "litellm_params": {
                    "type": "object"
                  }
                },
                "required": ["model_name", "litellm_params"]
              }
            },
            "litellm_settings": {
              "type": "object"
            }
          },
          "required": ["model_list"]
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "required": ["name"]
          }
        }
      },
      "required": ["enabled", "image", "config"]
    },
    "localInference": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ollama": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "pullPolicy": {
                  "type": "string"
                }
              },
              "required": ["repository", "tag"]
            },
            "port": {
              "type": "integer"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                }
              },
              "required": ["enabled"]
            }
          },
          "required": ["image", "models"]
        }
      },
      "required": ["enabled"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": ["type", "port"]
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  },
  "required": ["provider", "gateway", "service"]
}
